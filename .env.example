# Optional. Without it the agent uses its built-in template for the briefs.
ANTHROPIC_API_KEY=
# Optional: override the model
ANTHROPIC_MODEL=claude-sonnet-4-6
# Your own company domain(s), comma-separated. Rows from these domains are treated as booth staff and dropped.
INTERNAL_DOMAINS=ourcompany.com
# Event / campaign name stamped on every imported row
EVENT_NAME=SaaS Ops Summit London 2026
# Value stamped in the "Recent Lead Source" column of import_update.csv / import_create.csv. Leave empty to omit the column.
LEAD_SOURCE_VALUE=Event
